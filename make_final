#!/usr/bin/env python3
"""make_final - collect your Lab 3 code submission into final_lab3.zip.

    ./make_final                 # from the root of the profiler directory
    python make_final            # same thing, if ./ does not work on your shell

Gathers the files you wrote and
reports what is missing rather than quietly shipping an incomplete zip. It
never modifies your work.

Standard library only, like install.py, so it runs wherever the profiler does.
"""

from __future__ import annotations

import fnmatch
import glob
import pathlib
import sys
import zipfile

ROOT = pathlib.Path(__file__).resolve().parent
OUT = ROOT / "final_lab3.zip"

# The files each task asks you to write. `orig` names a pristine copy shipped
# beside the file, when one exists, so we can tell you if it looks untouched.
REQUIRED = [
    ("kernels/lab3/bp_stress/bp_stress.c", "5", "kernels/lab3/bp_stress/bp_stress.c.orig"),
    ("kernels/lab3/rob_stress/rob_stress.c", "5", "kernels/lab3/rob_stress/rob_stress.c.orig"),
    ("kernels/lab3/conv/student_conv.c", "10", "kernels/lab3/conv/student_conv.c.orig"),
    ("kernels/lab3/morph/student_morph.c", "10", None),
    ("kernels/lab3/vtcm/student_vtcm.c", "11", None),
    ("kernels/lab3/memshare/memshare.cpp", "12", None),
]

# Files found by name anywhere in the tree. Empty now that Task 5 has fixed
# paths under kernels/lab3/ like every other task.
SEARCH: list[tuple[str, str]] = []

SKIP = {"__pycache__", ".git", ".pytest_cache"}


def find(name: str) -> pathlib.Path | None:
    """Locate a student-authored file anywhere sensible in the tree."""
    direct = ROOT / name
    if direct.is_file():
        return direct
    for p in ROOT.rglob(name):
        if not any(part in SKIP or part == ".toolchain" for part in p.parts):
            return p
    return None


def main() -> int:
    found: list[tuple[pathlib.Path, str]] = []
    missing: list[tuple[str, str]] = []
    warnings: list[str] = []

    for rel, task, orig in REQUIRED:
        p = ROOT / rel
        if p.is_file():
            found.append((p, rel))
            if orig and (ROOT / orig).is_file():
                if p.read_bytes() == (ROOT / orig).read_bytes():
                    warnings.append(
                        "%s is identical to the version you were given - "
                        "task %s looks unstarted" % (rel, task))
        else:
            missing.append((rel, task))

    for name, task in SEARCH:
        p = find(name)
        if p:
            found.append((p, p.relative_to(ROOT).as_posix()))
        else:
            missing.append((name, task))

    print("Lab 3 code submission\n")
    for p, rel in found:
        print("  [ok]      %s" % rel)
    for rel, task in missing:
        print("  [MISSING] %s   (task %s)" % (rel, task))

    for w in warnings:
        print("\n  [warning] %s" % w)

    if missing:
        print("\n%d item(s) missing. Writing the zip anyway so you can submit"
              " what you have," % len(missing))
        print("but check the list above first.\n")

    with zipfile.ZipFile(OUT, "w", zipfile.ZIP_DEFLATED) as z:
        for p, rel in found:
            z.write(p, rel)

    n = len(found)
    print("\nWrote %s  (%d files, %.1f KB)"
          % (OUT.name, n, OUT.stat().st_size / 1024.0))
    print("Submit it to the Lab 3 code assignment. One person per team.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
